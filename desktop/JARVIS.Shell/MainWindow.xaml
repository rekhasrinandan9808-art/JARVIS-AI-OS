<Window x:Class="JARVIS.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JARVIS AI OS" 
        Height="768" Width="1366"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="1024">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#1A1A2E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔷 JARVIS AI OS" VerticalAlignment="Center" Margin="10,0,0,0" 
                               FontFamily="Segoe UI" FontWeight="Bold" Foreground="#00D4FF" FontSize="14"/>
                    <TextBlock Text="v1.0" VerticalAlignment="Center" Margin="10,0,0,0" 
                               FontFamily="Segoe UI" Foreground="#666" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="─" Click="MinimizeButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Width="30"/>
                    <Button Content="☐" Click="MaximizeButton_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" Width="30"/>
                    <Button Content="✕" Click="CloseButton_Click" Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" FontSize="16" Width="30"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            
            <!-- Hologram Area (Left) - NO OVERLAY TEXT -->
            <Grid Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#0A0A1A" Offset="0"/>
                        <GradientStop Color="#1A1A3E" Offset="0.5"/>
                        <GradientStop Color="#0A0A1A" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <wv2:WebView2 x:Name="webView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
            
            <!-- Chatbox Area (Right) -->
            <Border Grid.Column="1" Background="#0A0A1A" BorderBrush="#1A1A3E" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Chat Header -->
                    <Border Grid.Row="0" Background="#1A1A2E" BorderBrush="#2A2A4E" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="💬 JARVIS Chat" VerticalAlignment="Center" 
                                       FontFamily="Segoe UI" FontWeight="Bold" 
                                       Foreground="#00D4FF" FontSize="14" Margin="15,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                                <Ellipse x:Name="statusDot" Width="8" Height="8" Fill="#FF6B6B" Margin="0,0,6,0"/>
                                <TextBlock x:Name="connectionStatus" Text="Offline" 
                                           FontFamily="Segoe UI" FontSize="12" 
                                           Foreground="#FF6B6B"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Chat Messages -->
                    <ScrollViewer Grid.Row="1" x:Name="chatScrollViewer" 
                                  VerticalScrollBarVisibility="Auto" 
                                  Background="#0A0A1A">
                        <StackPanel x:Name="chatMessages" Margin="10" Orientation="Vertical">
                            <Border Background="#1A1A2E" CornerRadius="8" 
                                    Padding="12,8" Margin="0,0,0,10" MaxWidth="320" HorizontalAlignment="Left">
                                <TextBlock Text="🔷 JARVIS AI OS initialized. How can I help you today?" 
                                           Foreground="#00D4FF" FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Chat Input -->
                    <Border Grid.Row="2" Background="#1A1A2E" BorderBrush="#2A2A4E" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="chatInput" 
                                     Background="#0A0A1A" Foreground="#FFFFFF" 
                                     BorderBrush="#2A2A4E" BorderThickness="1" 
                                     FontSize="14" Padding="10,8" 
                                     VerticalContentAlignment="Center"
                                     Text="Type a message..." 
                                     GotFocus="ChatInput_GotFocus" 
                                     LostFocus="ChatInput_LostFocus"
                                     KeyDown="ChatInput_KeyDown"/>
                            
                            <Button x:Name="sendButton" 
                                    Content="➤" 
                                    Grid.Column="1"
                                    Width="50" Height="34" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    Background="#00D4FF" Foreground="#0A0A1A" 
                                    FontWeight="Bold" FontSize="18"
                                    BorderThickness="0" CornerRadius="4"
                                    Click="SendButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
